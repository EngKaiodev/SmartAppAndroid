<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="#f0f2f5">

    <!-- Header -->
    <RelativeLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#4F46E5"
        android:padding="16dp">

        <ImageButton
            android:id="@+id/btnvoltarhist"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="bntvl"
            android:src="@drawable/ic_arrow_back"
            android:layout_alignParentStart="true"
            app:tint="@android:color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Histórico de Serviços"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold"/>
    </RelativeLayout>

    <!-- Conteúdo Principal -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Card de Filtros -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardUseCompatPadding="true"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Filtrar Histórico:"
                        android:textColor="#1F2937"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>

                    <Spinner
                        android:id="@+id/sortBySpinner"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:padding="12dp"/>

                    <EditText
                        android:id="@+id/filterByProfessionalEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="Filtrar por prestador..."
                        android:padding="12dp"
                        android:background="@drawable/edittext_background"/>

                    <Button
                        android:id="@+id/applyFiltersButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="#4F46E5"
                        android:text="Aplicar Filtros"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:padding="12dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Título da Lista -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Seus Serviços Anteriores:"
                android:textColor="#1F2937"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <!-- Lista de Histórico -->
            <LinearLayout
                android:id="@+id/serviceHistoryList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Item 1 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="2dp"
                    android:layout_marginBottom="16dp"
                    android:onClick="onServiceItemClick">


                </androidx.cardview.widget.CardView>

                <!-- Item 2 -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvhistoricoServico"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="2dp"
                    android:layout_marginBottom="16dp"
                    android:onClick="onServiceItemClick"
                    tools:listitem="@layout/historico_category"
                    android:orientation="vertical">


                </androidx.recyclerview.widget.RecyclerView>
            </LinearLayout>

            <!-- Mensagem quando não há histórico -->
            <TextView
                android:id="@+id/noHistoryMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nenhum serviço encontrado no seu histórico."
                android:textColor="#6B7280"
                android:textSize="16sp"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="gone"/>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>