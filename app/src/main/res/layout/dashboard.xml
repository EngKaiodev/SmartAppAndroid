<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F2F5">

    <!-- Header -->
    <RelativeLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#4F46E5"
        android:padding="16dp"
        android:layout_alignParentTop="true">

        <TextView
            android:id="@+id/logoTextHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="SmartServ"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"/>

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/notificationBell"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="dashboard2"
                app:srcCompat="@drawable/ic_bell"
               />

            <TextView
                android:id="@+id/notificationCount"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_alignTop="@id/notificationBell"
                android:layout_alignEnd="@id/notificationBell"
                android:background="@drawable/notification_badge"
                android:gravity="center"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:visibility="gone"/>

            <RelativeLayout
                android:id="@+id/profileMenuToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/notificationBell"
                android:layout_marginStart="16dp"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/profileImage"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/profile_placeholder"
                    android:contentDescription="Foto de perfil"
                    android:scaleType="centerCrop"
                    android:layout_centerVertical="true"
                    android:background="@drawable/circle_border"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/profileImage"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="8dp"
                    android:text="Olá, João!"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"/>
            </RelativeLayout>
        </RelativeLayout>
    </RelativeLayout>

    <!-- Banner de Notificação (inicialmente oculto) -->
    <RelativeLayout
        android:id="@+id/upcomingAppointmentNotification"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/header"
        android:background="#FFDE00"
        android:padding="12dp"
        android:visibility="gone"
        android:layout_margin="16dp"
        android:elevation="4dp"
        android:backgroundTint="#FFDE00">

        <TextView
            android:id="@+id/notificationText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@id/notificationCloseBtn"
            android:text="**Lembrete:** Seu agendamento de **Corte Feminino** com **Maria Cabeleireira** é às **14:00**."
            android:textColor="#000000"
            android:textSize="14sp"/>

        <ImageButton
            android:id="@+id/notificationCloseBtn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:srcCompat="@drawable/ic_close"
            />
    </RelativeLayout>

    <!-- Conteúdo Principal -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header"
        android:padding="16dp"
        android:layout_above="@+id/bottomNav">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Categorias Populares -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Categorias Populares"
                android:textColor="#1F2937"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Categoria 1 -->
                    <LinearLayout
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:background="@drawable/category_background"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:layout_marginEnd="16dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:contentDescription="dashboard3"
                            android:src="@drawable/ic_scissors"
                            />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Cabeleireiro"
                            android:textColor="#1F2937"
                            android:textSize="14sp"/>
                    </LinearLayout>

                    <!-- Categoria 2 -->
                    <LinearLayout
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:background="@drawable/category_background"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:layout_marginEnd="16dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_spa"
                            />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Estética"
                            android:textColor="#1F2937"
                            android:textSize="14sp"/>
                    </LinearLayout>

                    <!-- Categoria 3 -->
                    <LinearLayout
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:background="@drawable/category_background"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:layout_marginEnd="16dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_dumbbell"
                            />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Personal"
                            android:textColor="#1F2937"
                            android:textSize="14sp"/>
                    </LinearLayout>

                    <!-- Categoria 4 -->
                    <LinearLayout
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:background="@drawable/category_background"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:layout_marginEnd="16dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_paint"
                            />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Manicure"
                            android:textColor="#1F2937"
                            android:textSize="14sp"/>
                    </LinearLayout>

                    <!-- Categoria 5 -->
                    <LinearLayout
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:background="@drawable/category_background"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:layout_marginEnd="16dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_car"
                            />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Mecânico"
                            android:textColor="#1F2937"
                            android:textSize="14sp"/>
                    </LinearLayout>

                    <!-- Categoria 6 -->
                    <LinearLayout
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:background="@drawable/category_background"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_ellipsis"
                           />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Outros"
                            android:textColor="#1F2937"
                            android:textSize="14sp"/>
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Profissionais em Destaque -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Profissionais em Destaque"
                android:textColor="#1F2937"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="2"
                android:alignmentMode="alignBounds"
                android:columnOrderPreserved="false"
                android:useDefaultMargins="true"
                android:padding="4dp">

                <!-- Profissional 1 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="8dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:src="@drawable/profile_placeholder"
                            android:background="@drawable/circle_border"
                            android:scaleType="centerCrop"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ana Esteticista"
                            android:textColor="#1F2937"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginTop="8dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Especialista em Limpeza de Pele"
                            android:textColor="#6B7280"
                            android:textSize="12sp"
                            android:layout_marginTop="4dp"/>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:layout_marginTop="8dp">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_star"
                                />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="4.9 (120)"
                                android:textColor="#FFD700"
                                android:textSize="12sp"
                                android:layout_marginStart="4dp"/>
                        </LinearLayout>

                        <Button
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:text="Agendar"
                            android:textColor="@android:color/white"
                            android:backgroundTint="#4F46E5"
                            android:background="@drawable/rounded_button"
                            android:layout_marginTop="16dp"
                            android:minHeight="36dp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Profissional 2 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="8dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:src="@drawable/profile_placeholder"
                            android:background="@drawable/circle_border"
                            android:scaleType="centerCrop"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Carlos Personal"
                            android:textColor="#1F2937"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginTop="8dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Treinamento Funcional"
                            android:textColor="#6B7280"
                            android:textSize="12sp"
                            android:layout_marginTop="4dp"/>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:layout_marginTop="8dp">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_star"
                                />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="4.8 (95)"
                                android:textColor="#FFD700"
                                android:textSize="12sp"
                                android:layout_marginStart="4dp"/>
                        </LinearLayout>

                        <Button
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:text="Agendar"
                            android:textColor="@android:color/white"
                            android:backgroundTint="#4F46E5"
                            android:background="@drawable/rounded_button"
                            android:layout_marginTop="16dp"
                            android:minHeight="36dp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Profissional 3 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="8dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:src="@drawable/profile_placeholder"
                            android:background="@drawable/circle_border"
                            android:scaleType="centerCrop"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Beatriz Nails"
                            android:textColor="#1F2937"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginTop="8dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Manicure e Pedicure Gel"
                            android:textColor="#6B7280"
                            android:textSize="12sp"
                            android:layout_marginTop="4dp"/>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:layout_marginTop="8dp">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_star"
                                />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="5.0 (210)"
                                android:textColor="#FFD700"
                                android:textSize="12sp"
                                android:layout_marginStart="4dp"/>
                        </LinearLayout>

                        <Button
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Agendar"
                            android:textColor="@android:color/white"
                            android:backgroundTint="#4F46E5"
                            android:background="@drawable/rounded_button"
                            android:layout_marginTop="16dp"
                            android:minHeight="36dp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </GridLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@android:color/white"
        android:orientation="horizontal"
        android:elevation="8dp"
        android:paddingVertical="8dp">

        <LinearLayout
            android:id="@+id/btn_inicio"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_home"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Início"
                android:textColor="#4F46E5"
                android:textSize="12sp"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_buscar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_search"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Buscar"
                android:textColor="#6B7280"
                android:textSize="12sp"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_agendamento"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_calendar"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Agendamentos"
                android:textColor="#6B7280"
                android:textSize="12sp"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_perfil"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="dashboard1"
                android:src="@drawable/ic_profile"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Perfil"
                android:textColor="#6B7280"
                android:textSize="12sp"
                android:layout_marginTop="4dp"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>