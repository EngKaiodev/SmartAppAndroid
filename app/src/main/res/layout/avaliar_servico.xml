<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f0f2f5"
    android:padding="16dp"
    android:tint="#FBBF24">


    <!-- Header -->
    <RelativeLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#4F46E5"
        android:elevation="4dp"
        android:padding="16dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            android:tint="@android:color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"
            android:layout_toEndOf="@id/btnBack"
            android:text="Avaliar Serviço"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Main Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header"
        android:paddingTop="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_background"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Avalie o serviço de"
                android:textAlignment="center"
                android:textColor="#374151"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvProfessionalName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/tvTitle"
                android:layout_marginTop="8dp"
                android:text="Nome do Prestador"
                android:textAlignment="center"
                android:textColor="#4F46E5"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvServiceName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/tvProfessionalName"
                android:layout_marginTop="4dp"
                android:text="Serviço Realizado"
                android:textAlignment="center"
                android:textColor="#6B7280"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvServiceDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/tvServiceName"
                android:layout_marginTop="4dp"
                android:text="em DD/MM/AAAA"
                android:textAlignment="center"
                android:textColor="#6B7280"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/starContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/tvServiceDate"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="24dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/star1"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_star_empty" />

                <ImageView
                    android:id="@+id/star2"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_star_empty" />

                <ImageView
                    android:id="@+id/star3"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_star_empty" />

                <ImageView
                    android:id="@+id/star4"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_star_empty" />

                <ImageView
                    android:id="@+id/star5"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_star_empty" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvRatingText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/starContainer"
                android:layout_marginTop="16dp"
                android:text="Selecione uma avaliação"
                android:textAlignment="center"
                android:textColor="#374151"
                android:textSize="18sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etComment"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_below="@id/tvRatingText"
                android:layout_marginTop="24dp"
                android:background="@drawable/edittext_background"
                android:gravity="top"
                android:hint="Descreva sua experiência (opcional)"
                android:padding="12dp" />

            <Button
                android:id="@+id/btnSubmit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/etComment"
                android:layout_marginTop="24dp"
                android:background="@drawable/button_primary"
                android:drawableStart="@drawable/ic_send"
                android:drawablePadding="8dp"
                android:paddingVertical="12dp"
                android:text="Enviar Avaliação"
                android:textAllCaps="false"
                android:textColor="@android:color/white" />
        </RelativeLayout>
    </ScrollView>

    <!-- Modal -->
    <RelativeLayout
        android:id="@+id/messageModal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:visibility="gone">

        <RelativeLayout
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:background="@drawable/modal_background"
            android:padding="24dp">

            <ImageView
                android:id="@+id/ivModalIcon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_centerHorizontal="true"
                android:src="@drawable/ic_success" />

            <TextView
                android:id="@+id/tvModalTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/ivModalIcon"
                android:layout_marginTop="16dp"
                android:textAlignment="center"
                android:textColor="#374151"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvModalMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/tvModalTitle"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                android:textAlignment="center"
                android:textColor="#374151" />

            <Button
                android:id="@+id/btnModalOk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/tvModalMessage"
                android:background="@drawable/button_primary"
                android:text="OK"
                android:textAllCaps="false"
                android:textColor="@android:color/white" />
        </RelativeLayout>
    </RelativeLayout>
</RelativeLayout>