<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#4F46E5"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageButton
            android:id="@+id/btnVoltarCodigo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Voltar"
            android:src="@drawable/ic_arrow_back"
            app:tint="@android:color/white" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Verificar Código"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- Conteúdo Principal -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <!-- Card Principal -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="?android:attr/colorBackground"
                android:layout_marginTop="32dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="32dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Verificação de Código"
                        android:textAlignment="center"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Digite o código de 4 dígitos enviado para:"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="16sp"
                        android:textAlignment="center"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:id="@+id/tvEmailPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="usuario@exemplo.com"
                        android:textColor="#4F46E5"
                        android:textSize="16sp"
                        android:textAlignment="center"
                        android:textStyle="bold"
                        android:layout_marginBottom="24dp"/>

                    <!-- Container para os 4 campos de código -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginBottom="32dp">

                        <EditText
                            android:id="@+id/etCode1"
                            android:hint="4"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:background="?android:attr/editTextBackground"
                            android:gravity="center"
                            android:inputType="number"
                            android:maxLength="1"
                            android:textSize="24sp"
                            android:textColor="?android:attr/textColorPrimary"
                            android:layout_margin="8dp"/>

                        <EditText
                            android:id="@+id/etCode2"
                            android:hint="2"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:background="?android:attr/editTextBackground"
                            android:gravity="center"
                            android:inputType="number"
                            android:maxLength="1"
                            android:textSize="24sp"
                            android:textColor="?android:attr/textColorPrimary"
                            android:layout_margin="8dp"/>

                        <EditText
                            android:id="@+id/etCode3"
                            android:hint="3"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:background="?android:attr/editTextBackground"
                            android:gravity="center"
                            android:inputType="number"
                            android:maxLength="1"
                            android:textSize="24sp"
                            android:textColor="?android:attr/textColorPrimary"
                            android:layout_margin="8dp"
                            />

                        <EditText
                            android:id="@+id/etCode4"
                            android:hint="5"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:background="?android:attr/editTextBackground"
                            android:gravity="center"
                            android:inputType="number"
                            android:maxLength="1"
                            android:textSize="24sp"
                            android:textColor="?android:attr/textColorPrimary"
                            android:layout_margin="8dp"/>
                    </LinearLayout>

                    <!-- Botão Verificar -->
                    <Button
                        android:id="@+id/btnVerificarCodigo"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:backgroundTint="#4F46E5"
                        android:text="Verificar Código"
                        android:textColor="@android:color/white"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp"/>

                    <!-- Reenviar código -->
                    <TextView
                        android:id="@+id/tvReenviarCodigo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Reenviar código"
                        android:textColor="#4F46E5"
                        android:textSize="16sp"
                        android:textAlignment="center"
                        android:textStyle="bold"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>