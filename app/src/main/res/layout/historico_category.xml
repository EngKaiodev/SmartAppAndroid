<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    android:layout_marginBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Linha superior com nome do serviço e data -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/nomeservico"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Corte Feminino"
                android:textColor="#1F2937"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/servicodata"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10/05/2024"
                android:textColor="#6B7280"
                android:textSize="14sp"/>
        </LinearLayout>

        <!-- Nome do profissional -->
        <TextView
            android:id="@+id/nomeprof"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Com: Maria Cabeleireira"
            android:textColor="#6B7280"
            android:textSize="14sp"/>

        <!-- Preço do serviço -->
        <TextView
            android:id="@+id/servicovalor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Valor: R$ 80,00"
            android:textColor="#6B7280"
            android:textSize="14sp"/>

        <!-- Avaliação com estrelas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/avaliacaoserv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Avaliação:"
                android:textColor="#6B7280"
                android:textSize="14sp"/>

            <LinearLayout
                android:id="@+id/ratingStars"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_star_filled"
                    android:contentDescription="Estrela 1"/>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_star_filled"
                    android:contentDescription="Estrela 2"/>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_star_filled"
                    android:contentDescription="Estrela 3"/>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_star_filled"
                    android:contentDescription="Estrela 4"/>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_star_empty"
                    android:contentDescription="Estrela 5"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>