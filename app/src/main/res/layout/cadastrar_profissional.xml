<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:padding="16dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="vertical"
        android:background="@color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:elevation="4dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="@color/white">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="S"
                    android:textColor="#4F46E5"
                    android:textSize="40sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="SmartServ"
                    android:textColor="@android:color/black"
                    android:textSize="32sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Cadastre-se como Profissional"
                android:textColor="@android:color/black"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:text="Etapa 1 de 2: Suas informações"
                android:textColor="@android:color/black"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@color/white">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="Suas Informações"
                    android:textColor="@android:color/black"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <!-- Stacked vertically - Name -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilProfName"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="Nome Completo"
                    android:textColorHint="@color/black"
                    app:hintTextColor="@android:color/black"
                    app:boxStrokeColor="@android:color/black">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtProfNome"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:inputType="textPersonName|textCapWords"
                        android:textColor="@android:color/black" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Stacked vertically - Email -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilProfEmail"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="E-mail"
                    android:textColorHint="@color/black"
                    app:hintTextColor="@android:color/black"
                    app:boxStrokeColor="@android:color/black">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtProfEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:inputType="textEmailAddress"
                        android:textColor="@android:color/black" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Stacked vertically - Phone -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilProfPhone"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="Telefone"
                    android:textColorHint="@color/black"
                    app:hintTextColor="@android:color/black"
                    app:boxStrokeColor="@android:color/black">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtProftelefone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:inputType="phone"
                        android:textColor="@android:color/black" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Stacked vertically - CPF/CNPJ -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilProfCpfCnpj"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="CPF ou CNPJ"
                    android:textColorHint="@color/black"
                    app:helperText="Pessoa física ou jurídica"
                    app:helperTextTextColor="@android:color/black"
                    app:hintTextColor="@android:color/black"
                    app:boxStrokeColor="@android:color/black">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtProfCpfCnpj"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:inputType="text"
                        android:textColor="@android:color/black" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Campo CEP adicionado acima do endereço -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilProfCep"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="CEP"
                    android:textColorHint="@color/black"
                    app:hintTextColor="@android:color/black"
                    app:boxStrokeColor="@android:color/black">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtProfCep"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:inputType="number"
                        android:textColor="@android:color/black" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Stacked vertically - Address -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilProfAddress"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="Endereço"
                    android:textColorHint="@color/black"
                    app:helperText="Rua, bairro, cidade, estado"
                    app:helperTextTextColor="@android:color/black"
                    app:hintTextColor="@android:color/black"
                    app:boxStrokeColor="@android:color/black">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtProfendereco"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:inputType="textPostalAddress|textCapSentences"
                        android:textColor="@android:color/black" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Campo Número adicionado abaixo do endereço -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilProfNumber"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="Número"
                    android:textColorHint="@color/black"
                    app:hintTextColor="@android:color/black"
                    app:boxStrokeColor="@android:color/black">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtProfnumero"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:inputType="number"
                        android:textColor="@android:color/black" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Stacked vertically - Razão Social -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilProfRazaoSocial"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="Razão Social (Opcional, se CNPJ)"
                    android:textColorHint="@color/black"
                    app:hintTextColor="@android:color/black"
                    app:boxStrokeColor="@android:color/black">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtProfRazaoSocial"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:inputType="textCapSentences"
                        android:textColor="@android:color/black" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Stacked vertically - Description -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilProfDescription"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="Sobre Você/Sua Empresa"
                    android:textColorHint="@color/black"
                    app:hintTextColor="@android:color/black"
                    app:boxStrokeColor="@android:color/black">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtProfdescricao"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:imeOptions="actionNext"
                        android:inputType="textMultiLine|textCapSentences"
                        android:minLines="3"
                        android:textColor="@android:color/black" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Stacked vertically - Password -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilProfPassword"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="Senha"
                    android:textColorHint="@color/black"
                    app:helperText="Mínimo 6 caracteres"
                    app:helperTextTextColor="@android:color/black"
                    app:passwordToggleEnabled="true"
                    app:passwordToggleTint="@android:color/black"
                    app:hintTextColor="@android:color/black"
                    app:boxStrokeColor="@android:color/black">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtSenha"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:inputType="textPassword"
                        android:textColor="@android:color/black" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Stacked vertically - Confirm Password -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilProfConfirmPassword"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="Confirmar Senha"
                    android:textColorHint="@color/black"
                    app:passwordToggleEnabled="true"
                    app:passwordToggleTint="@android:color/black"
                    app:hintTextColor="@android:color/black"
                    app:boxStrokeColor="@android:color/black">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtProfConfSenha"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword"
                        android:textColor="@android:color/black" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Container de erro para mostrar as mensagens de erro -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/erro_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tvError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAlignment="center"
                    android:text="Verifique os campos novamente"
                    android:textColor="@color/red_500"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnproximoPro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:backgroundTint="#4F46E5"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:text="Próximo (Cadastrar Serviços)"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                app:cornerRadius="8dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Já tem uma conta? "
                    android:textColor="@android:color/black"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvProfLoginLink"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="Faça login"
                    android:textColor="@android:color/black"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</RelativeLayout>