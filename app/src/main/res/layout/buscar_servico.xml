<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_gray">

    <!-- Header Fixo no Topo -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/indigo_600"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:layout_alignParentTop="true">

        <ImageButton
            android:id="@+id/btnvoltarbs"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="btnvoltar"
            android:src="@drawable/ic_arrow_back"
            android:background="?selectableItemBackgroundBorderless"
            android:padding="8dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SmartServ"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Buscar Serviços
"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- Conteúdo Principal (abaixo do cabeçalho) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header"
        android:padding="16dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Search Bar -->
            <EditText
                android:id="@+id/searchQuery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Buscar por nome, serviço ou especialidade..."
                android:padding="16dp"
                android:background="@drawable/edittext_rounded"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="8dp"
                android:layout_marginBottom="16dp"/>

            <!-- Filter Section -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Filtros"
                        android:textColor="@color/text_dark"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="16dp">

                        <!-- Category Filter -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Categoria"
                            android:textColor="@color/text_dark"
                            android:textSize="14sp"
                            android:layout_marginBottom="8dp"/>

                        <Spinner
                            android:id="@+id/categoryFilter"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"/>

                        <!-- Location Filter -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Localização"
                            android:textColor="@color/text_dark"
                            android:textSize="14sp"
                            android:layout_marginTop="16dp"
                            android:layout_marginBottom="8dp"/>

                        <EditText
                            android:id="@+id/locationFilter"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:hint="Ex: Centro, Araçatuba"
                            android:background="@drawable/edittext_background"/>

                        <!-- Rating Filter -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Avaliação Mínima"
                            android:textColor="@color/text_dark"
                            android:textSize="14sp"
                            android:layout_marginTop="16dp"
                            android:layout_marginBottom="8dp"/>

                        <Spinner
                            android:id="@+id/ratingFilter"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"/>
                    </LinearLayout>

                    <!-- Filter Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="end">

                        <Button
                            android:id="@+id/clearFiltersBtn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Limpar Filtros"
                            android:textColor="@color/text_dark"
                            android:backgroundTint="@color/gray_100"
                            android:paddingStart="24dp"
                            android:paddingEnd="24dp"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:layout_marginEnd="8dp"/>

                        <Button
                            android:id="@+id/applyFiltersBtn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Aplicar Filtros"
                            android:textColor="@android:color/white"
                            android:backgroundTint="@color/indigo_600"
                            android:paddingStart="24dp"
                            android:paddingEnd="24dp"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Results Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Resultados da Busca"
                android:textColor="@color/text_dark"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <!-- Professionals List -->
            <LinearLayout
                android:id="@+id/professionalListings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:divider="@drawable/divider"
                android:showDividers="middle"
                android:dividerPadding="16dp">

                <!-- Professionals will be added here dynamically -->
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>