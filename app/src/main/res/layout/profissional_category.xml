<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="#F0F2F5">
    <androidx.cardview.widget.CardView
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:id="@+id/ProfissionalContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/profile_placeholder"
                android:background="@drawable/circle_border"
                android:scaleType="centerCrop"/>

            <TextView
                android:id="@+id/nome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ana Esteticista"
                android:textColor="#1F2937"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"/>

            <TextView
                android:id="@+id/especialidade"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Especialista em Limpeza de Pele"
                android:textColor="#6B7280"
                android:textSize="12sp"
                android:layout_marginTop="4dp"
                android:maxWidth="180dp"
                android:ellipsize="end"
                android:singleLine="true"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginTop="8dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_star"/>

                <TextView
                    android:id="@+id/avaliacao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4.9 (120)"
                    android:textColor="#FFD700"
                    android:textSize="12sp"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>

            <Button
                android:layout_width="120dp"
                android:layout_height="50dp"
                android:text="Agendar"
                android:textColor="@android:color/white"
                android:backgroundTint="#4F46E5"
                android:background="@drawable/rounded_button"
                android:layout_marginTop="16dp"
                android:minHeight="36dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</RelativeLayout>