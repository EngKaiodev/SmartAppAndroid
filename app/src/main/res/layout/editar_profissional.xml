<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="vertical">

        <!-- Header (unchanged as requested) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#4F46E5"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageButton
                android:id="@+id/btnvoltarProfisional"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentStart="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="gere2"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="SmartServ"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Meu Perfil Profissional"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Profile Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/light_gray"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Form Fields -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Nome Completo -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="Nome Completo"
                        android:textColor="@android:color/black"
                        android:textSize="14sp" />

                    <!-- E-mail -->
                    <EditText
                        android:id="@+id/edtNomePro"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="?android:attr/editTextBackground"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="Maria Cabeleireira"
                        android:textColor="@android:color/black"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="4dp"
                        android:text="E-mail"
                        android:textColor="@android:color/black"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/edtEmailPro"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="?android:attr/editTextBackground"
                        android:enabled="false"
                        android:inputType="textEmailAddress"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="maria.cabelos@exemplo.com"
                        android:textColor="@android:color/black"
                        android:textSize="16sp" />

                    <!-- Telefone -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="4dp"
                        android:text="Telefone"
                        android:textColor="@android:color/black"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/edtTelefonePro"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="?android:attr/editTextBackground"
                        android:inputType="phone"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="(11) 91234-5678"
                        android:textColor="@android:color/black"
                        android:textSize="16sp" />

                    <!-- CPF/CNPJ -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="4dp"
                        android:text="CPF ou CNPJ"
                        android:textColor="@android:color/black"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/edtCpfCnpjPro"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="?android:attr/editTextBackground"
                        android:enabled="false"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="XX.XXX.XXX/XXXX-XX"
                        android:textColor="@android:color/black"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Para pessoa física (CPF) ou jurídica (CNPJ)."
                        android:textColor="@android:color/black"
                        android:textSize="12sp" />

                    <!-- CEP -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="4dp"
                        android:text="CEP"
                        android:textColor="@android:color/black"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/edtCepPro"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="?android:attr/editTextBackground"
                        android:inputType="number"
                        android:maxLength="9"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="98765-432"
                        android:textColor="@android:color/black"
                        android:textSize="16sp" />

                    <!-- Endereço -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="4dp"
                        android:maxLines="3"
                        android:text="Endereço"
                        android:textColor="@android:color/black"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/edtEnderecoPro"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?android:attr/editTextBackground"
                        android:maxLines="3"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="Rua da Beleza, Bairro Estilo, Cidade, SP"
                        android:textColor="@android:color/black"
                        android:textSize="16sp" />

                    <!-- Número -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="4dp"
                        android:text="Número"
                        android:textColor="@android:color/black"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/edtNumeroPro"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="?android:attr/editTextBackground"
                        android:inputType="number"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="456"
                        android:textColor="@android:color/black"
                        android:textSize="16sp" />

                    <!-- Razão Social -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="4dp"
                        android:text="Razão Social (Opcional, se CNPJ)"
                        android:textColor="@android:color/black"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/edtRazaoSocialPro"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="?android:attr/editTextBackground"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="Salão da Maria LTDA"
                        android:textColor="@android:color/black"
                        android:textSize="16sp" />

                    <!-- Descrição -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="4dp"
                        android:text="Sobre Você/Sua Empresa"
                        android:textColor="@android:color/black"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/edtDescricaoPro"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:background="?android:attr/editTextBackground"
                        android:gravity="top"
                        android:inputType="textMultiLine"
                        android:padding="16dp"
                        android:text="Cabeleireira com mais de 10 anos de experiência, especialista in cortes modernos e coloração. Atendimento personalizado e ambiente acolhedor."
                        android:textColor="@android:color/black"
                        android:textSize="16sp" />

                    <!-- Alterar Senha Section -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="24dp"
                        android:layout_marginBottom="16dp"
                        android:background="?android:attr/dividerVertical" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:text="Alterar Senha"
                        android:textColor="@android:color/black"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <!-- Nova Senha -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="Nova Senha"
                        android:textColor="@android:color/black"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/edtNovasenhaPro"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="?android:attr/editTextBackground"
                        android:hint="••••••••"
                        android:inputType="textPassword"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textColor="@android:color/black"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Mínimo de 6 caracteres."
                        android:textColor="@android:color/black"
                        android:textSize="12sp" />

                    <!-- Confirmar Nova Senha -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="4dp"
                        android:text="Confirmar Nova Senha"
                        android:textColor="@android:color/black"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/edtConfimaNovaSenhaPro"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="?android:attr/editTextBackground"
                        android:hint="••••••••"
                        android:inputType="textPassword"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textColor="@android:color/black"
                        android:textSize="16sp" />

                    <!-- Container de erro para mostrar as mensagens de erro -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/erro_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Verifique os campos novamente"
                            android:textAlignment="center"
                            android:textColor="@color/red_500"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <Button
                        android:id="@+id/btnSalvarPro"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:backgroundTint="#16A34A"
                        android:paddingStart="24dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="24dp"
                        android:paddingBottom="12dp"
                        android:text="Salvar Alterações"
                        android:textColor="@android:color/black" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>