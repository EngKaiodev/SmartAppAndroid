<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    app:startDestination="@id/home_fragment"
    android:id="@+id/client_nav">

    <fragment
        android:id="@+id/home_fragment"
        android:name="com.example.smartapp.fragments.registro.DashboardFragment"
        android:label="HomeFragment"
        tools:layout="@layout/dashboard">
        <action
            android:id="@+id/action_Home_to_criar_produto"
            app:destination="@id/buscar_produto_fragment" />
        <action
            android:id="@+id/action_home_to_perfil_prestador"
            app:destination="@id/perfil_prestador_fragment"/>
    </fragment>
    <fragment
        android:id="@+id/buscar_produto_fragment"
        android:name="com.example.smartapp.fragments.registro.BuscarProServFragment"
        android:label="BuscarProdutoFragment"
        tools:layout="@layout/buscar_pro_serv">
        <action
            android:id="@+id/action_buscar_produto_to_buscar_profissional"
            app:destination="@id/buscar_profissional_fragment" />
        <action
            android:id="@+id/action_buscar_produto_to_buscar_servico"
            app:destination="@id/buscar_servico_fragment"/>
    </fragment>

    <fragment
        android:id="@+id/buscar_profissional_fragment"
        android:label="BuscarProfissionalFragment"
        tools:layout="@layout/pesquisar_profissional">
        <action
            android:id="@+id/action_buscar_prestador_to_perfil_prestador"
            app:destination="@id/perfil_prestador_fragment" />
    </fragment>

    <fragment
        android:id="@+id/perfil_prestador_fragment"
        android:name="com.example.smartapp.fragments.registro.AgendarServicoFragment"
        android:label="PerfilPrestadorFragment"
        tools:layout="@layout/perfil_prestador" >
        <action
            android:id="@+id/agendar_servico_fragment"
            app:destination="@id/agendar_servico_fragment"/>
        <action
            android:id="@+id/avaliar_prestardor_fragment"
            app:destination="@id/avaliar_prestardor_fragment"/>
    </fragment>

    <fragment
        android:id="@id/avaliar_prestardor_fragment"
        android:name="com.example.smartapp.fragments.registro.AvaliarServicoFragment"
        android:label="AvaliarPrestadorFragment"
        tools:layout="@layout/avaliar_servico"/>

    <fragment
        android:id="@+id/agendar_servico_fragment"
        android:name="com.example.smartapp.fragments.registro.AgendarServicoFragment"
        android:label="AgendarServicoFragment"
        tools:layout="@layout/agendar_servico">
        <action
            android:id="@+id/confirmar_agendamento_fragment"
            app:destination="@+id/confimar_agendamento_fragment"/>
    </fragment>

    <fragment
        android:id="@+id/confimar_agendamento_fragment"
        android:name="com.example.smartapp.fragments.registro.ConfirmarAgendamentoFragment"
        android:label="ConfirmarAgendamentoFragment"
        tools:layout="@layout/confirmar_agendamento"/>

    <fragment
        android:id="@+id/buscar_servico_fragment"
        android:name="com.example.smartapp.fragments.registro.BuscarServicoFragment"
        android:label="BuscarServicoFragment"
        tools:layout="@layout/buscar_servico" />

</navigation>