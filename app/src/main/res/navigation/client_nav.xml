<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/client_nav"
    app:startDestination="@id/home_fragment">

    <fragment
        android:id="@+id/gerenciar_agendamento_fragment"
        android:name="com.example.smartapp.fragments.registro.GerenciarAgendamentoFragment"
        android:label="GerenciarAgendamentoFragment"
        tools:layout="@layout/gerenciar_agendamento">
        <action
            android:id="@+id/reagendar_fragment"
            app:destination="@id/reagendar_fragment" />

    </fragment>
    <fragment
        android:id="@id/reagendar_fragment"
        android:name="com.example.smartapp.fragments.registro.ReagendarFragment"
        android:label="ReagendarFragment"
        tools:layout="@layout/reagendar">
        <action
            android:id="@+id/agendar_servico_fragment"
            app:destination="@id/agendar_servico_fragment" />

    </fragment>
    <fragment
        android:id="@+id/gerenciar_notificacoes_fragment"
        android:name="com.example.smartapp.fragments.registro.GerenciarNotificacoesFragment"
        android:label="GerenciarNotificacoesFragment"
        tools:layout="@layout/gerenciar_notificacoes" />

    <fragment
        android:id="@id/editar_profissional_fragment"
        android:name="com.example.smartapp.fragments.registro.EditarProfissionalFragment"
        android:label="EditarProfissionalFragment"
        tools:layout="@layout/editar_profissional" />

    <fragment
        android:id="@+id/perfil_fragment"
        android:name="com.example.smartapp.fragments.registro.PerfilFragment"
        android:label="PerfilFragment"
        tools:layout="@layout/perfil">
        <action
            android:id="@+id/action_calendario_fragment"
            app:destination="@id/calendario_fragment"/>
        <action
            android:id="@+id/editar_cliente_fragment"
            app:destination="@id/editar_cliente_fragment" />
        <action
            android:id="@+id/editar_profissional_fragment"
            app:destination="@id/editar_profissional_fragment" />
        <action
            android:id="@+id/gerenciar_servico_fragment"
            app:destination="@+id/gerenciar_servico_fragment" />
        <action
            android:id="@+id/historico_servico_fragment"
            app:destination="@+id/historico_servico_fragment" />
        <action
            android:id="@+id/gerenciar_notificacoes_fragment"
            app:destination="@+id/gerenciar_notificacoes_fragment" />


    </fragment>

    <fragment
        android:id="@+id/calendario_fragment"
        android:name="com.example.smartapp.fragments.registro.CalendarioFragment"
        android:label="CalendarioFragment"
        tools:layout="@layout/gerenciar_horarios"/>
    <fragment
        android:id="@id/historico_servico_fragment"
        android:name="com.example.smartapp.fragments.registro.HistoricoServicoFragment"
        android:label="HistoricoServicoFragment"
        tools:layout="@layout/historico_servico" />
    <fragment
        android:id="@+id/gerenciar_servico_fragment"
        android:name="com.example.smartapp.fragments.registro.GerenciarServicoFragment"
        android:label="GerenciarServicoFragment"
        tools:layout="@layout/gerenciar_servico">
        <action
            android:id="@+id/action_criar_servico_fragment"
            app:destination="@+id/action_criar_servico_fragment" />
    </fragment>


    <fragment
        android:id="@+id/home_fragment"
        android:name="com.example.smartapp.fragments.registro.DashboardFragment"
        android:label="HomeFragment"
        tools:layout="@layout/dashboard">
        <action
            android:id="@+id/action_Home_to_criar_produto"
            app:destination="@id/buscar_produto_fragment" />
        <action
            android:id="@+id/action_home_to_perfil_prestador"
            app:destination="@id/perfil_fragment" />
        <action
            android:id="@+id/action_home_to_agendamentos"
            app:destination="@id/gerenciar_agendamento_fragment" />
        <action
            android:id="@+id/action_agendar_servico"
            app:destination="@id/agendar_servico_fragment" />
        <action
            android:id="@+id/action_home_to_prestador_perfil"
            app:destination="@id/perfil_prestador_fragment" />

    </fragment>

    <fragment
        android:id="@+id/editar_cliente_fragment"
        android:name="com.example.smartapp.fragments.registro.EditarClienteFragment"
        android:label="EditarProdutoFragment"
        tools:layout="@layout/editar_cliente" />

    <fragment
        android:id="@+id/buscar_produto_fragment"
        android:name="com.example.smartapp.fragments.registro.BuscarProServFragment"
        android:label="BuscarProdutoFragment"
        tools:layout="@layout/buscar_pro_serv">
        <action
            android:id="@+id/action_buscar_produto_to_buscar_profissional"
            app:destination="@id/buscar_profissional_fragment" />
        <action
            android:id="@+id/action_buscar_produto_to_buscar_servico"
            app:destination="@id/buscar_servico_fragment" />
    </fragment>

    <fragment
        android:id="@+id/buscar_profissional_fragment"
        android:name="com.example.smartapp.fragments.registro.PesquisarProfissionaisFragment"
        android:label="BuscarProfissionalFragment"
        tools:layout="@layout/pesquisar_profissional">

        <action
            android:id="@+id/perfil_prestador_fragment"
            app:destination="@id/perfil_prestador_fragment" />
    </fragment>

    <fragment
        android:id="@+id/perfil_prestador_fragment"
        android:name="com.example.smartapp.fragments.registro.PerfilPrestadorFragment"
        android:label="PerfilPrestadorFragment"
        tools:layout="@layout/perfil_prestador">
        <argument
            android:name="proId"
            app:argType="integer"/>
        <action
            android:id="@+id/agendar_servico_fragment"
            app:destination="@id/agendar_servico_fragment" />
        <action
            android:id="@+id/avaliar_prestardor_fragment"
            app:destination="@id/avaliar_prestardor_fragment" />
        <action
            android:id="@+id/action_avaliar_tela"
            app:destination="@id/action_avaliar_tela" />
    </fragment>

    <fragment
        android:id="@id/avaliar_prestardor_fragment"
        android:name="com.example.smartapp.fragments.registro.AvaliarServicoFragment"
        android:label="AvaliarPrestadorFragment"
        tools:layout="@layout/avaliar_servico" />

    <fragment
        android:id="@+id/agendar_servico_fragment"
        android:name="com.example.smartapp.fragments.registro.AgendarServicoFragment"
        android:label="AgendarServicoFragment"
        tools:layout="@layout/agendar_servico">
        <action
            android:id="@+id/confirmaragendamentofragment"
            app:destination="@+id/confirmaragendamentofragment" />
    </fragment>

    <fragment
        android:id="@+id/confirmaragendamentofragment"
        android:name="com.example.smartapp.fragments.registro.ConfirmarAgendamentoFragment"
        android:label="ConfirmarAgendamentoFragment"
        tools:layout="@layout/confirmar_agendamento" />

    <fragment
        android:id="@+id/buscar_servico_fragment"
        android:name="com.example.smartapp.fragments.registro.BuscarServicoFragment"
        android:label="BuscarServicoFragment"
        tools:layout="@layout/buscar_servico">
        <action
            android:id="@+id/action_ir_prestador"
            app:destination="@id/buscar_profissional_fragment" />
    </fragment>

    <fragment
        android:id="@+id/action_avaliar_tela"
        android:name="com.example.smartapp.fragments.registro.AvaliarTelaFragment"
        android:label="AvaliarTelaFragment"
        tools:layout="@layout/avaliar_tela">

    </fragment>

    <fragment
        android:id="@+id/action_criar_servico_fragment"
        android:name="com.example.smartapp.fragments.registro.CriarServicoFragment"
        android:label="CriarServicoFragment"
        tools:layout="@layout/cria_servico">

    </fragment>

</navigation>