<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/agendamento_nav.xml">

    <fragment
        android:id="@+id/dashboard_fragment"
        android:name="com.example.smartapp.fragments.registro.DashboardFragment"
        android:label="DashboardFragment"
        tools:layout="@layout/dashboard">
        <action
            android:id="@+id/gerenciar_agendamento_fragment"
            app:destination="@id/gerenciar_agendamento_fragment"/>

    </fragment>

    <fragment
        android:id="@+id/gerenciar_agendamento_fragment"
        android:name="com.example.smartapp.fragments.registro.GerenciarAgendamentoFragment"
        android:label="GerenciarAgendamentoFragment"
        tools:layout="@layout/gerenciar_agendamento">
        <action
            android:id="@+id/reagendar_fragment"
            app:destination="@id/reagendar_fragment"/>

    </fragment>

    <fragment
        android:id="@id/reagendar_fragment"
        android:name="com.example.smartapp.fragments.registro.ReagendarFragment"
        android:label="ReagendarFragment"
        tools:layout="@layout/reagendar">
        <action
            android:id="@+id/agendar_servico_fragment"
            app:destination="@id/agendar_servico_fragment"/>

    </fragment>

    <fragment
        android:id="@+id/agendar_servico_fragment"
        android:name="com.example.smartapp.fragments.registro.AgendarServicoFragment"
        android:label="AgendarServicoFragment"
        tools:layout="@layout/agendar_servico">
        <action
            android:id="@+id/confirmar_agendamento_fragment"
            app:destination="@+id/confimar_agendamento_fragment"/>
    </fragment>

    <fragment
        android:id="@+id/confimar_agendamento_fragment"
        android:name="com.example.smartapp.fragments.registro.ConfirmarAgendamentoFragment"
        android:label="ConfirmarAgendamentoFragment"
        tools:layout="@layout/confirmar_agendamento"/>



</navigation>